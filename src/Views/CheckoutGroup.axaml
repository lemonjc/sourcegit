<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="450"
             x:Class="SourceGit.Views.CheckoutGroup"
             x:DataType="vm:CheckoutGroup">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Check}"/>
      <TextBlock FontSize="18" Margin="8,0,0,0" Classes="bold" Text="{DynamicResource Text.CheckoutGroup.Title}"/>
    </StackPanel>

    <Grid Margin="0,12,0,0" RowDefinitions="32" ColumnDefinitions="120,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Checkout.Target}"/>
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
        <Path Width="14" Height="14" Margin="4,0" Data="{StaticResource Icons.Branch}"/>
        <TextBlock Text="{Binding BranchName, Mode=OneWay}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Margin="0,8,0,0" MaxHeight="280">
      <ItemsControl ItemsSource="{Binding Repositories, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CheckoutGroupRepository">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="28">
              <Path Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                    Data="{StaticResource Icons.Check}"
                    Fill="Green"
                    IsVisible="{Binding IsCurrent, Mode=OneWay}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneWay}"/>

              <CheckBox Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="{DynamicResource Text.CheckoutGroup.WillCheckout}"
                        IsVisible="{Binding HasBranch, Mode=OneWay}"
                        IsChecked="{Binding WillCheckout, Mode=TwoWay}"/>

              <CheckBox Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="{DynamicResource Text.CheckoutGroup.CreateIfMissing}"
                        IsVisible="{Binding HasBranch, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
                        IsChecked="{Binding CreateIfMissing, Mode=TwoWay}"/>

              <TextBlock Grid.Column="4" Classes="info_label" VerticalAlignment="Center"
                         Text="{DynamicResource Text.CheckoutGroup.BranchMissing}"
                         IsVisible="{Binding HasBranch, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
