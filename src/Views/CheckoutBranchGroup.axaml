<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:m="using:SourceGit.Models"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="450"
             x:Class="SourceGit.Views.CheckoutBranchGroup"
             x:DataType="vm:CheckoutBranchGroup">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Check}"/>
      <TextBlock FontSize="18" Margin="8,0,0,0" Classes="bold" Text="{DynamicResource Text.CheckoutBranchGroup.Title}"/>
    </StackPanel>

    <Grid Margin="0,12,0,0" RowDefinitions="32,Auto" ColumnDefinitions="160,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CheckoutBranchGroup.Target}"/>
      <ComboBox Grid.Row="0" Grid.Column="1"
                Height="28"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Branches, Mode=OneWay}"
                SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                ToolTip.Tip="{DynamicResource Text.CheckoutBranchGroup.TargetTip}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="{x:Type m:Branch}">
            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
              <Path Width="12" Height="12"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource Brush.FG1}"
                    Data="{StaticResource Icons.Branch}"
                    IsVisible="{Binding IsLocal, Mode=OneWay}"/>
              <Path Width="12" Height="12"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Remote}"
                    IsVisible="{Binding IsLocal, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"/>
              <TextBlock VerticalAlignment="Center" Text="{Binding FriendlyName, Mode=OneWay}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <CheckBox Grid.Row="1" Grid.Column="1"
                Content="{DynamicResource Text.CheckoutBranchGroup.AllowOverwrite}"
                IsChecked="{Binding AllowOverwrite, Mode=TwoWay}"
                ToolTip.Tip="-B"/>
    </Grid>

    <ScrollViewer Margin="0,8,0,0" MaxHeight="280">
      <ItemsControl ItemsSource="{Binding Repositories, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CheckoutBranchGroupRepository">
            <Grid ColumnDefinitions="Auto,110,*,Auto" Height="30">
              <CheckBox Grid.Column="0"
                        MinWidth="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanToggle, Mode=OneWay}"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneWay}"/>
              <TextBlock Grid.Column="2"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding ActionDescription, Mode=OneWay}"/>
              <ComboBox Grid.Column="3"
                        Width="175"
                        Height="26"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Branches, Mode=OneWay}"
                        SelectedItem="{Binding SelectedBranch, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="{x:Type m:Branch}">
                    <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
                      <Path Width="12" Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Brush.FG1}"
                            Data="{StaticResource Icons.Branch}"
                            IsVisible="{Binding IsLocal, Mode=OneWay}"/>
                      <Path Width="12" Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Brush.FG2}"
                            Data="{StaticResource Icons.Remote}"
                            IsVisible="{Binding IsLocal, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"/>
                      <TextBlock VerticalAlignment="Center" Text="{Binding FriendlyName, Mode=OneWay}"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
